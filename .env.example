DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_INPUT_TOKEN_BUDGET=24000
MCP_HTTP_ENDPOINTS=
MCP_STDIO_SERVERS={}

# Docker 构建参数（可选）。Docker Hub 拉取慢时改成 ECR Public 镜像；
# 依赖下载慢时换成可访问的 PyPI 索引，例如腾讯云源。
# NODE_BASE_IMAGE=public.ecr.aws/docker/library/node:22-alpine
# PYTHON_BASE_IMAGE=public.ecr.aws/docker/library/python:3.12-slim
# PYTHON_PACKAGE_INDEX=https://mirrors.cloud.tencent.com/pypi/simple
