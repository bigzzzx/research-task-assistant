DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_INPUT_TOKEN_BUDGET=24000
MCP_HTTP_ENDPOINTS=
MCP_STDIO_SERVERS={}

# Docker 构建参数（可选）。默认从 Amazon ECR Public 拉取官方基础镜像，
# 并从国内可访问的 PyPI 镜像安装依赖，在访问 Docker Hub / PyPI 较慢的网络里也能构建。
# 如果你的网络访问官方源更快，取消对应注释即可。
# NODE_BASE_IMAGE=node:22-alpine
# PYTHON_BASE_IMAGE=python:3.12-slim
# PYTHON_PACKAGE_INDEX=https://pypi.org/simple
